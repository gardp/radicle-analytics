# ==========================================================================
# .env.example — Environment Variable Template
# ==========================================================================
# Purpose:
#   Documents the environment variables consumed by the Vite frontend.
#   Copy this file to ".env" (or ".env.local") and adjust values as needed.
#   Vite only exposes variables prefixed with VITE_ to client-side code.
#
# Used by:
#   - src/api/client.js  — reads VITE_API_URL via import.meta.env.VITE_API_URL
#     to set the axios baseURL for all HTTP requests to the FastAPI backend.
#
# Relationship to backend:
#   - VITE_API_URL must point to the FastAPI server's root URL.
#     In development the backend defaults to http://localhost:8000
#     (configured in backend/app/main.py with uvicorn).
# ==========================================================================

# Base URL of the FastAPI backend — all API calls are prefixed with this.
# In production, change to the deployed backend URL (e.g. https://api.example.com).
VITE_API_URL=http://localhost:8000
